{
  "name": "borderless-pay",
  "version": "1.1.0",
  "private": true,
  "description": "Borderless Pay — secure cross-border + domestic payments backend (zero runtime dependencies).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "smoke": "bash scripts/release-smoke.sh",
    "check": "for f in src/*.js test/*.js; do node --check \"$f\"; done",
    "audit:verify": "node -e \"import('./src/ledger.js')\""
  },
  "keywords": [
    "payments",
    "cross-border",
    "upi",
    "fintech",
    "ledger"
  ],
  "license": "UNLICENSED",
  "optionalDependencies": {
    "pg": "^8.22.0"
  }
}

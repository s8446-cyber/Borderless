# ---- Borderless Pay environment template ----
# Copy to .env and fill in REAL values before any production deploy.
# NEVER commit the real .env. In production the server refuses to start unless
# BP_SIGNING_SECRET and BP_ENC_KEY are set (fail-closed).

# Environment: development | production
BP_ENV=production
NODE_ENV=production

# Port to listen on
PORT=4000

# Path to the file-backed store (use a mounted volume in production)
BP_DB=/app/data/db.json

# PostgreSQL persistence (overrides the file store when set). Requires the
# optional driver: npm install pg   (Docker: --build-arg WITH_PG=true)
# State snapshots + APPEND-ONLY ledger/audit mirrors are stored in Postgres.
# BP_PG_URL=postgres://user:password@host:5432/borderless

# REQUIRED IN PRODUCTION ------------------------------------------------------
# HMAC secret used to sign payment authorizations.
# Generate: openssl rand -hex 48
BP_SIGNING_SECRET=

# AES-256-GCM key for field-level encryption at rest.
# Provide EITHER 64 hex chars (32 bytes) OR a long passphrase (derived via scrypt).
# Generate: openssl rand -hex 32
BP_ENC_KEY=

# CORS allowlist (comma-separated origins). Empty in production = same-origin only.
# Example: https://app.borderlesspay.com,https://borderlesspay.com
BP_CORS_ORIGINS=

# Set true ONLY when running behind a trusted reverse proxy / load balancer,
# so the client IP is read from X-Forwarded-For for rate limiting.
BP_TRUST_PROXY=true

# Bearer token for the Prometheus scrape endpoint GET /api/metrics.
# REQUIRED to expose metrics in production (endpoint stays hidden if unset).
# Generate: openssl rand -hex 32
BP_METRICS_TOKEN=

# TRANSACTIONAL EMAIL (password-reset delivery) -------------------------------
# Provider: resend | sendgrid | console (console logs bodies — dev only, the
# server REFUSES it in production). Unset in production = reset tokens are
# issued but undeliverable (a loud warning is logged at boot and per request).
BP_EMAIL_PROVIDER=resend
# API key for the chosen provider (required in production when a provider is set)
BP_EMAIL_API_KEY=
# From address (verify the domain with your provider: SPF + DKIM)
BP_EMAIL_FROM="Borderless Pay <no-reply@borderlesspay.app>"
# Public URL of the web app, used inside emails (e.g. https://app.borderlesspay.com)
BP_APP_ORIGIN=

# SETTLEMENT MODE --------------------------------------------------------------
# "sandbox" (default): money movement is SIMULATED end-to-end — balances are
# funded only via the audited /api/topup flow and every receipt is stamped
# "sandbox". "live" is FAIL-CLOSED: the server refuses to boot until a licensed
# PSP / sponsor-bank adapter is integrated and named in BP_PSP_PROVIDER.
BP_SETTLEMENT_MODE=sandbox

# KYC PROVIDER ----------------------------------------------------------------
# "sandbox" simulates screening and auto-approves — fine for demos/staging,
# NEVER for real money (the server warns loudly at boot in production).
# Integrate a licensed provider in src/kyc.js and select it here.
BP_KYC_PROVIDER=sandbox

# OPTIONAL TUNING (sane defaults shown) ---------------------------------------
# Request body size cap (bytes)
BP_BODY_LIMIT=1048576
# Session lifetime (ms) — default 24h
BP_SESSION_TTL_MS=86400000
# Refresh-token lifetime (ms) — default 30 days
BP_REFRESH_TTL_MS=2592000000
# Maintenance sweep cadence (expired sessions/refresh/quotes GC) — default 5 min
BP_SWEEP_INTERVAL_MS=300000
# Idempotency-key retention after a payment settles — default 24h
BP_IDEM_TTL_MS=86400000
# Rate limits (per IP, sliding window)
BP_RL_WINDOW_MS=60000
BP_RL_MAX=120
BP_RL_AUTH_MAX=20
BP_RL_PAYMENT_MAX=30
# Failed-PIN lockout
BP_LOCK_MAX_FAILS=5
BP_LOCK_WINDOW_MS=900000
BP_LOCK_MS=900000
# Transaction limits (minor units, i.e. paise)
BP_TXN_MIN_MINOR=100
BP_TXN_MAX_MINOR=20000000
BP_INTL_TXN_MAX_MINOR=50000000
BP_DAILY_TOTAL_MAX_MINOR=100000000
BP_DAILY_COUNT_MAX=100
